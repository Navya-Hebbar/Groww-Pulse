# ──────────────────────────────────────────────
# Groww Pulse — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://growwpulse:growwpulse@localhost:5432/growwpulse?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-this-to-a-strong-random-secret

# Market Data
MARKET_API_KEY=
MARKET_API_BASE_URL=

# LLM (Optional — app works without this)
LLM_API_KEY=

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Demo Mode (set to "true" to use deterministic demo data)
DEMO_MODE=false
